# Carpeta de archivos subidos: nunca ejecutar código aquí (defensa en profundidad).
Options -ExecCGI -Indexes
<IfModule mod_php.c>php_admin_flag engine off</IfModule>
<IfModule mod_php7.c>php_admin_flag engine off</IfModule>
<IfModule mod_php8.c>php_admin_flag engine off</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .cgi .pl .py
RemoveType .php .phtml .php3 .phar
# Bloquea el acceso directo a cualquier archivo ejecutable que llegue a colarse.
<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh|htaccess)$">
  Require all denied
</FilesMatch>
