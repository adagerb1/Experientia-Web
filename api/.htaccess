# Enruta todas las peticiones de /api al front controller.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Permite el header Authorization (algunos hostings lo filtran).
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Sube los límites de carga para documentos (PDF/Excel). Solo aplica con mod_php.
<IfModule mod_php.c>
  php_value upload_max_filesize 30M
  php_value post_max_size 32M
  php_value max_execution_time 120
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 30M
  php_value post_max_size 32M
  php_value max_execution_time 120
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 30M
  php_value post_max_size 32M
  php_value max_execution_time 120
</IfModule>
